# ============================================
# AyurSync EMR - Public Repository .gitignore
# ============================================

# ---------- Environment & Secrets ----------
.env
.env.*
!.env.example

# ---------- Python ----------
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/
dist/
build/

# ---------- Node / Frontend ----------
/node_modules
package-lock.json

# ---------- IDE & Editor ----------
.vscode/
.idea/
*.swp
*.swo
*~
.history/

# ---------- OS Artifacts ----------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ---------- Security / Certificates ----------
*.pem
*.key
*.cert
*.p12
*.pfx
*.jks

# ---------- Build & Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Database ----------
*.sqlite3
*.db
